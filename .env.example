MCP_AUTH_TOKEN=your_secret_bearer_token_here
CUMULUSMX_URL=http://cumulusmx:8998
PORT=8000
MCP_STRIP_PREFIX=/mcp-res
CUMULUS_DATA_START_YEAR=2023
CUMULUS_FROST_THRESHOLD=0.0
CUMULUS_CACHE_TTL=600

# Segundo token (opcional) que solo permite consultar: las tools de escritura se niegan y las contraseñas salen enmascaradas
MCP_AUTH_TOKEN_READONLY=

# Copias de seguridad previas a cada escritura (ajustes, líneas del dayfile, récords) y registro de auditoría.
# CUMULUS_BACKUP_DIR=none las desactiva. En Docker usa un volumen en /data.
CUMULUS_BACKUP_DIR=
CUMULUS_BACKUP_KEEP=200
CUMULUS_AUDIT_FILE=

# Zona horaria de la estación (IANA, p. ej. Europe/Madrid): necesaria para usar fechas legibles en interval_data/daily_data
CUMULUS_TIMEZONE=

# true = enmascara contraseñas y claves en get_settings / get_mysql_settings / get_mqtt_settings (por defecto se devuelven)
CUMULUS_MASK_SECRETS=false

# Timeout (segundos) y reintentos de las peticiones GET a CumulusMX
CUMULUS_TIMEOUT=30
CUMULUS_RETRIES=2

# Autenticación HTTP Basic con CumulusMX (opcional, si CumulusMX requiere usuario/password)
CUMULUS_USER=
CUMULUS_PASSWORD=

# Habilitar o deshabilitar herramientas de modificación y escritura (default: true)
ENABLE_WRITE_TOOLS=true  # false = servidor de solo lectura (las tools de escritura no se publican)

# Nivel de log: info (default), debug, warning, error
LOG_LEVEL=info

# Prometheus metrics at GET /metrics (needs the Bearer token). false = disabled.
# MCP_METRICS=true
